{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedate",
  "account_id": "ea93a11f9c4cf5128fd1deffb3908158",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "routes": [
    { "pattern": "pokedate.fr", "custom_domain": true },
    { "pattern": "www.pokedate.fr", "custom_domain": true },
  ],
  "workers_dev": true,
  "dev": { "host": "localhost" },
  "vars": { "NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN": "c62cb03df93349a7828f898f10f028df" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedate",
      "database_id": "91138166-09e5-47ba-bb0c-869867b07a12",
      "migrations_dir": "migrations",
    },
  ],
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "PUBLISH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "EVENT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHARE_IMAGE_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
  ],
  "triggers": { "crons": ["0 4 * * *"] },
  "preview_urls": false,
}
