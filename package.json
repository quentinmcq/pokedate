{
  "name": "pokedate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check && bun run typecheck",
    "data": "bun scripts/fetch-pokemon.mjs server/data/pokemon.json"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "sass-embedded": "^1.105.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.151.0"
  },
  "packageManager": "bun@1.4.3"
}
