{
  "name": "pokedate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "bun run sprites && nuxt build && wrangler dev",
    "deploy": "bun run check && bun run sprites && nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare && lefthook install",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test:unit",
    "data": "bun scripts/fetch-pokemon.ts",
    "sprites": "bun scripts/fetch-sprites.ts",
    "icons": "bun scripts/app-icons.ts",
    "stats": "bun scripts/stats.ts",
    "share-image": "bun scripts/default-share-image.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "nuxt build && playwright test"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.2",
    "nuxt-security": "^2.6.0",
    "uqr": "0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/lucide": "^1.2.146",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass-embedded": "^1.105.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  },
  "packageManager": "bun@1.4.3"
}
