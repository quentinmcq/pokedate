{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [".nuxt/**", ".output/**", "node_modules/**", "server/data/**"],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__vue_app__"]
      }
    ]
  }
}
