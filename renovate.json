{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":dependencyDashboard"],
  "timezone": "Europe/Paris",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Nuxt, Vue and their modules are released together",
      "groupName": "nuxt and vue",
      "matchPackageNames": ["nuxt", "@nuxt/**", "nuxt-security", "vue", "vue-router", "@vue/**", "@unhead/**"]
    },
    {
      "description": "Nuxt does not accept Vue 3.6 yet: it would install a second copy of Vue",
      "matchPackageNames": ["vue"],
      "allowedVersions": "<3.6.0"
    },
    {
      "groupName": "tests",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "@nuxt/test-utils",
        "@vue/test-utils",
        "happy-dom",
        "@playwright/test",
        "playwright",
        "@axe-core/playwright"
      ]
    },
    {
      "groupName": "lint and format",
      "matchPackageNames": ["oxlint", "oxfmt"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "vue-tsc", "@types/**"]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler"]
    },
    {
      "groupName": "build and assets",
      "matchPackageNames": ["sass-embedded", "sharp", "@iconify-json/**"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "bun",
      "matchDepTypes": ["packageManager"]
    },
    {
      "description": "Dev tooling: automerge minor and patch updates once CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "GitHub Actions pinned by digest: automerge everything but major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Major updates: one PR per package, reviewed by hand",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "addLabels": ["major"],
      "automerge": false
    }
  ]
}
